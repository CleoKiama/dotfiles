{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "formatter": false,
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.config/opencode/context7-key}"
        }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "axiom-logs": {
        "type": "remote",
        "url": "https://mcp.axiom.co/mcp"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      },
      "codebase-memory": {
        "type": "local",
        "command": ["codebase-memory-mcp"]
      },
      "youtube-transcript": {
        "type": "local",
        "command": ["npx", "-y", "@lunks/youtube-transcript-mcp"]
      },
      "aws-mcp": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-proxy-for-aws-cli@latest",
          "https://aws-mcp.us-east-1.api.aws/mcp"
        ],
        "environment": {
          "AWS_MCP_PROXY_PROFILES": "default"
        }
      },
      "searxng": {
        "type": "local",
        "command": ["npx", "-y", "mcp-searxng"],
        "environment": {
          "SEARXNG_URL": "http://localhost:39201"
        }
      },
      "pi-web-access": {
        "type": "local",
        "command": ["npx", "-y", "pi-web-access"],
        "environment": {
          "PI_CODING_AGENT_DIR": "/home/cleo/.config/pi/agent"
        }
      }
    }
  },
  "autoupdate": false,
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "allow",
      "*.env.*": "allow",
      "*.env.example": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "plan": {
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    },
    "chat": {
      "description": "Casual conversation, explanations, and learning - no code changes",
      "model": "opencode/deepseek-v4.1-flash-free",
      "temperature": 0.7,
      "fallback_models": ["opencode/big-pickle", "opencode/minimax-m3.1-flash-free"],
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      }
    },
    "teacher": {
      "description": "Patient tutor for learning concepts, debugging explanations, best practices",
      "model": "opencode/mimo-v2.6-flash-free",
      "temperature": 0.5,
      "fallback_models": [
        "opencode/nemotron-3-ultra-free",
        "opencode/big-pickle"
      ],
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "explore": {
      "disable": true
    },
    "compaction": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "general": {
      "disable": true
    }
  },
  "plugin": ["opencode-wakatime"],
  "provider": {},
  "lsp": true
}
