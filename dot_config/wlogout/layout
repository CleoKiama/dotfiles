{
    "label": "lock",
    "action": "hyprlock",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "mmsg dispatch quit",
    "text": "Logout",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "hyprlock & sleep 0.5 && loginctl suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "reboot",
    "action": "loginctl reboot",
    "text": "Reboot",
    "keybind": "r"
}

{
    "label": "shutdown",
    "action": "loginctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}
