;; Source key capture for home compact keyboard (35 keys).
;;
;; Quirk: No physical grave/tilde key (`).
;; The top-left key is physical Esc, which maps to letter `q` (slot 35).
;;
;; Flat order (matches every deflayer token-for-token):
;;   top num row:    1 2 3 4 | 8 9 0 - =
;;   top alpha:      q w e r | i o p [ ]
;;   home alpha:     caps a s d f | k l ; ' ret
;;   bottom alpha:   x c | , .
;;   misc:           tab prtsc esc
(defsrc
  1    2    3    4    8    9    0    -    =
  q    w    e    r    i    o    p    [    ]
  caps a    s    d    f    k    l    ;    '    ret
  x    c    ,    .
  tab
  prtsc
  esc
)
