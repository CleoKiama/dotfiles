(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; v1.12.0+: require 100ms idle before a tap-hold key activates its hold
  ;; (ZMK-style require-prior-idle). Supplements same-hand suppression via
  ;; tap-hold-release-keys + hand-key lists.
  tap-hold-require-prior-idle 100
)

(defvar
  tap-time 150
  hold-time 200
  left-hand-keys (` 1 2 3 4 tab q w e r caps a s d f lshift z x c)
  right-hand-keys (6 7 8 9 0 - y u i o p [ ] ' h j k l ; n m , . / bspc)
)

(include defsrc/pc.kbd)
(include defalias/qwerty.kbd)

(defchords fp-esc 40
  (2 3) esc
  (2) f
  (3) p
)

;; Layout: base layer
(include deflayer/colemak-dh-base.kbd)  ;; Colemak-DH
(include deflayer/symbols.kbd)
(include deflayer/navigation.kbd)
(include deflayer/media.kbd)
