(defcfg
  process-unmapped-keys yes
  block-unmapped-keys yes
  concurrent-tap-hold yes
  chords-v2-min-idle 100
  delegate-to-first-layer yes
)

(defhands
  (left  ` esc 1 2 3 4 tab q w e r caps a s d f x c)
  (right 8 9 0 - = i o p [ ] k l ; ' ret \ / , .))

(defvar
  tap-time 180
  hold-time 180
  hrm-hold 250
  hrm-idle 170
)

(include defsrc/current.kbd)
(include defalias/qwerty.kbd)

(defchordsv2
  (2 3) @esc-base 40 first-release (numrow)
  (, .) @to-num   70 first-release ()
)

(include deflayer/colemak-dh-base.kbd)
(include deflayer/symbols.kbd)
(include deflayer/navigation.kbd)
(include deflayer/media.kbd)
