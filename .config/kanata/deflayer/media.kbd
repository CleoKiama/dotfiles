;; Media layer: MPRIS playback + volume/brightness.
;; Activated by holding physical j key (tap = k, hold = media).
;;
;; Grid order (matches defsrc/pc.kbd):
;;   8 top num  |  8 top alpha  |  9 home alpha  |  4 thumbs  |  tab prtsc ' |  - ` [

(deflayer media
  XX   XX   XX   XX   XX   XX   XX   XX
  pp   next brdn brup XX   XX   XX   XX
  vold volu mute XX   XX   XX   XX   XX   XX
  _    _    _    _
  prev
  XX
  XX
  XX   XX   XX
)

;; vim: set ft=lisp: