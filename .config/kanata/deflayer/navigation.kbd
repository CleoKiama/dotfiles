;; Navigation layer: Vim-style HJKL arrows, mouse wheel, editor shortcuts
;; Activated by holding Space thumb (m). ergonomic-shift: shifted up one
;; row; right hand one column right (column 6 y h n dead). Workspace keys
;; moved to `v` hold layer.

;; tab-origin: 1-col left shift
(deflayer navigation
  @cls S-tab tab  bck  XX   XX   XX   home pgdn pgup end
  @os-alt @os-met @os-ctl fwd XX XX   lft  down up   rght
  @ndo @cut @cpy @rdo @pst XX   XX   @mwl @mwd @mwu @mwr
  XX   del  _    XX   XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  @os-sft XX XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   @run XX   XX @fun XX   XX
)

;; numpad — REMOVED (unused).

;; Function keys — layer-while-held

;; tab-origin: 1-col left shift
(deflayer funpad
  f2   f3   f4   XX   XX   XX   XX   XX   XX   XX   XX
  f6   f7   f8   XX   XX   XX   XX   lalt lctl lmet
  f9   f10  f11  f12  XX   XX   XX   XX   XX   XX   XX
  XX   _    _    XX   XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  f5   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   f1   _    XX   XX
)

(defalias
  std (layer-switch base)
  pad XX ;; REMOVED
  fun (layer-while-held funpad)

  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)

  run XX
)

;; Workspace layer — Super+1..0, left hand only
;; Activated by holding right pinky (/)

;; tab-origin: 1-col left shift
(deflayer workspace
  M-7  M-8  M-9  M-0  XX   XX   XX   XX   XX   XX   XX
  M-2  M-3  M-4  M-5  XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   _    _    XX   XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  M-1  XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   M-6  XX   XX   XX
)

;; Modifiers layer (Callum-style) — DISABLED: physical m is now plain rsft
;; Activated by holding physical m key (Right Index thumb) — INERT
;; tab-origin: 1-col left shift
(deflayer modifiers
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
)

