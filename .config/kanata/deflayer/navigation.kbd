;; Navigation layer: Vim-style HJKL arrows, mouse wheel, editor shortcuts
;; Activated by holding Space thumb (m). ergonomic-shift: shifted up one
;; row; right hand one column right (column 6 y h n dead). Workspace keys
;; moved to `v` hold layer.

(deflayer navigation
  @pad @cls bck  fwd  XX   XX   XX   home pgdn pgup end
  @all @sav S-tab tab  XX   XX   lft  down up   rght
  XX   @ndo @cut @cpy @pst XX   XX   @mwl @mwd @mwu @mwr
  XX   XX   del  _    XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   @run XX   XX   @fun XX   XX
)

;; NumPad
(deflayer numpad
  XX   home up   end  pgup XX   XX   @/   @7   @8   @9
  XX   lft  down rght pgdn XX   @-   @4   @5   @6
  XX   XX   XX   XX   XX   XX   XX   @,   @1   @2   @3
  XX   XX   _    _    XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  @.   XX   XX   XX   @0   XX   XX
)

;; Function keys — layer-while-held

(deflayer funpad
  f1   f2   f3   f4   XX   XX   XX   XX   XX   XX   XX
  f5   f6   f7   f8   XX   XX   XX   lalt lctl lmet
  XX   f9   f10  f11  f12  XX   XX   XX   XX   XX   XX
  XX   XX   _    _    XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   _    XX   XX
)

(defalias
  std (layer-switch base)
  pad (layer-switch numpad)
  fun (layer-while-held funpad)

  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)

  run XX
)

;; Workspace layer — Super+1..0, left hand only
;; Activated by holding v thumb (escwsp)

(deflayer workspace
  M-6  M-7  M-8  M-9  M-0  XX   XX   XX   XX   XX   XX
  M-1  M-2  M-3  M-4  M-5  XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   _    _    XX   XX   XX   _    _    XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX
)

