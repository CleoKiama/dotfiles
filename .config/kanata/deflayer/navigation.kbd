;; Navigation layer: Vim-style HJKL arrows, mouse wheel, editor shortcuts.
;; Activated by holding the `c` thumb (Spc/Nav). FunPad: hold `]` here
;; (@fun). Modifiers: hold `,` thumb. Workspace: hold `ret` right pinky (@wsp).
;;
;; Grid order (matches defsrc/pc.kbd):
;;   9 top num  |  9 top alpha  |  10 home alpha  |  4 thumbs  |  tab prtsc `

(deflayer navigation
  @cls XX   XX   XX   home pgdn pgup end  XX
  S-tab tab  @fwd XX   lft  down up   rght @fun
  @ndo @cut @cpy @rdo @pst @mwl @mwd @mwu @mwr XX
  del  _    _    _
  @bck XX   XX
)

;; Function keys — hold `]` while on the navigation layer
(deflayer funpad
  f2   f3   f4   XX   XX   XX   XX   XX   XX
  f6   f7   f8   XX   XX   lctl lmet lalt XX
  f9   f10  f11  f12  XX   XX   XX   XX   XX   XX
  _    _    _    _
  f5   XX   f1
)

(defalias
  fun (layer-while-held funpad)

  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)
)

;; Workspace layer — Super+1..0
;; Activated by holding `ret` (right pinky)
(deflayer workspace
  M-7  M-8  M-9  M-0  XX   XX   XX   XX   XX
  M-2  M-3  M-4  M-5  XX   XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  _    _    _    _
  M-1  XX   M-6
)

;; Modifiers layer — one-shot / held modifiers
;; Activated by holding `,` thumb
(deflayer modifiers
  XX   XX   XX   XX   XX   XX   XX   XX   XX
  @os-alt @os-met @os-ctl XX   XX   @os-ctl @os-met @os-alt @os-sft
  XX   XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX
  @os-sft XX   XX
)

