;; Navigation layer: Vim-style HJKL arrows, mouse wheel, editor shortcuts.
;; Activated by holding the `c` thumb (Spc/Nav). FunPad: hold `[` here
;; (@fun). Modifiers: hold `m` thumb. Workspace: hold `'` right pinky (@wsp).
;;
;; Grid order (matches defsrc/pc.kbd):
;;   8 top num  |  8 top alpha  |  9 home alpha  |  4 thumbs  |  tab prtsc ' |  - ` [

(deflayer navigation
  @cls XX   XX   XX   home pgdn pgup end
  S-tab tab  fwd  XX   lft  down up   rght
  @ndo @cut @cpy @rdo @pst @mwl @mwd @mwu @mwr
  del  _    _    _
  bck
  XX
  XX
  XX   XX   @fun
)

;; Function keys — hold `[` while on the navigation layer
(deflayer funpad
  f2   f3   f4   XX   XX   XX   XX   XX
  f6   f7   f8   XX   XX   lalt lctl lmet
  f9   f10  f11  f12  XX   XX   XX   XX   XX
  _    _    _    _
  f5
  XX
  XX
  XX   f1   _
)

(defalias
  fun (layer-while-held funpad)

  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)
)

;; Workspace layer — Super+1..0
;; Activated by holding `'` (right pinky)
(deflayer workspace
  M-7  M-8  M-9  M-0  XX   XX   XX   XX
  M-2  M-3  M-4  M-5  XX   XX   XX   XX
  XX   XX   XX   XX   XX   XX   XX   XX   XX
  _    _    _    _
  M-1
  XX
  XX
  XX   M-6   XX
)

;; Modifiers layer — one-shot / held modifiers
;; Activated by holding `m` thumb
(deflayer modifiers
  XX   XX   XX   XX   XX   XX   XX   XX
  @os-alt @os-met @os-ctl XX   XX   @os-ctl @os-met @os-alt
  XX   XX   XX   XX   XX   XX   XX   XX   XX
  XX   XX   XX   XX
  @os-sft
  XX
  XX
  XX   XX   @os-sft
)

