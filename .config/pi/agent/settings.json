{
  "lastChangelogVersion": "1.0.0",
  "theme": "dark",
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "us.moonshotai.kimi-k3",
  "defaultThinkingLevel": "high",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "npmCommand": [
    "bun"
  ],
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "enabledModels": [
    "opencode/*-free",
    "antigravity/*",
    "amazon-bedrock/*"
  ],
  "extensions": [
    "~/.config/pi/agent/extensions/custom-compaction.ts"
  ],
  "prompts": [
    "~/dotfiles/.config/pi/agent/prompts"
  ],
  "packages": [
    "npm:pi-wakatime",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-dynamic-workflows",
    "npm:@yusukeshib/pi-stash",
    "npm:@gotgenes/pi-github-tools",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/Rahularya01/pi-antigravity",
    "npm:pi-subagents",
    "npm:pi-web-access"
  ],
  "hideThinkingBlock": true,
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "opencode/space-bunny-free",
        "thinking": "low"
      },
      "delegate": {
        "model": "opencode/space-bunny-free",
        "thinking": "low"
      },
      "librarian": {
        "model": "antigravity/gemini-3.7-flash",
        "thinking": "high"
      },
      "worker": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "high"
      },
      "researcher": {
        "model": "antigravity/gemini-3.8-flash"
      },
      "reviewer": {
        "model": "antigravity/claude-opus-4-6",
        "thinking": "high"
      },
      "planner": {
        "model": "amazon-bedrock/us.moonshotai.kimi-k3"
      },
      "oracle": {
        "model": "amazon-bedrock/us.anthropic.claude-opus-4-6-v1",
        "thinking": "high"
      },
      "evidence-auditor": {
        "model": "amazon-bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "thinking": "medium"
      }
    }
  }
}