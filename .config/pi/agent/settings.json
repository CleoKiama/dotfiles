{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "antigravity",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "high",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "npmCommand": [
    "bun"
  ],
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "enabledModels": [
    "antigravity/*",
    "amazon-bedrock/*",
    "acp/opencode"
  ],
  "acp": {
    "autoApproveTools": false,
    "agents": {
      "opencode": {
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "acp"
        ]
      }
    }
  },
  "extensions": [
    "~/.config/pi/agent/extensions/custom-compaction.ts"
  ],
  "prompts": [
    "~/dotfiles/.config/pi/agent/prompts"
  ],
  "packages": [
    "npm:pi-wakatime",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-dynamic-workflows",
    "npm:@yusukeshib/pi-stash",
    "npm:@gotgenes/pi-github-tools",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/Rahularya01/pi-antigravity",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-acp-provider",
    "npm:pi-acp-delegate"
  ],
  "hideThinkingBlock": true,
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "low"
      },
      "delegate": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "low"
      },
      "librarian": {
        "model": "antigravity/gemini-3.7-flash",
        "thinking": "high"
      },
      "worker": {
        "model": "antigravity/gemini-3.7-flash",
        "thinking": "high"
      },
      "researcher": {
        "model": "antigravity/gemini-3.8-flash"
      },
      "reviewer": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-4-6-v1",
        "thinking": "high"
      },
      "planner": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-4-6-v1"
      },
      "oracle": {
        "model": "amazon-bedrock/global.anthropic.claude-opus-4-6-v1",
        "thinking": "high"
      },
      "evidence-auditor": {
        "model": "amazon-bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
        "thinking": "medium"
      }
    }
  }
}