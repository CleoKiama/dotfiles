{
  "lastChangelogVersion": "0.82.1",
  "theme": "dark",
  "defaultProvider": "google-antigravity",
  "defaultModel": "antigravity-gemini-3.5-flash",
  "defaultThinkingLevel": "high",
  "shellCommandPrefix": "shopt -s expand_aliases\neval \"$(grep '^alias ' ~/.zshrc)\"",
  "npmCommand": [
    "pnpm"
  ],
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "enabledModels": [
    "opencode/*-free",
    "opencode-go/*",
    "google-antigravity/*"
  ],
  "skills": [
    "~/dotfiles/.config/pi/agent/skills/git-commit"
  ],
  "extensions": [
    "~/.config/pi/agent/extensions/custom-compaction.ts"
  ],
  "prompts": [
    "~/dotfiles/.config/pi/agent/prompts"
  ],
  "packages": [
    "npm:pi-wakatime",
    "git:github.com/obra/superpowers",
    "npm:pi-mcp-adapter",
    "npm:@tintinweb/pi-subagents",
    "npm:@tintinweb/pi-tasks",
    "npm:pi-dynamic-workflows",
    "npm:@yusukeshib/pi-stash",
    "npm:@cortexkit/pi-antigravity-auth",
    "npm:@gotgenes/pi-github-tools",
    "npm:@gotgenes/pi-permission-system"
  ],
  "hideThinkingBlock": true
}